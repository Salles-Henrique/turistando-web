  id: '999',
  title: 'SEU TITULO AQUI',
  location: 'CIDADE',
  country: 'PAIS',
  description: 'SUA DESCRICAO AQUI (60-120 caracteres)',
  image: 'URL DA IMAGEM',
  price: 1000,           // Seu preço em R$
  originalPrice: 1400,   // Opcional: preço antes do desconto
  rating: 4.8,
  reviews: 200,
  duration: 5,
  category: 'beach',     // beach | mountain | city | adventure
},
    `
  }
}

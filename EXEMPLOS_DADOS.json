  "validacoes_importantes": {
    "id": {
      "tipo": "string",
      "requerido": true,
      "regra": "Deve ser único, nunca repetir",
      "exemplo": "1, 2, 3, 'abc123'"
    },
    "title": {
      "tipo": "string",
      "requerido": true,
      "regra": "Máximo 70 caracteres, deve ser atrativo",
      "exemplo": "Paris Romantic Getaway, Bali Beach Paradise"
    },
    "location": {
      "tipo": "string",
      "requerido": true,
      "regra": "Cidade/região específica",
      "exemplo": "Paris, Bali, Rio de Janeiro"
    },
    "country": {
      "tipo": "string",
      "requerido": true,
      "regra": "País em inglês ou português",
      "exemplo": "France, Indonesia, Brazil"
    },
    "description": {
      "tipo": "string",
      "requerido": true,
      "regra": "60-120 caracteres, descritivo mas conciso",
      "exemplo": "Explore a cidade do amor com monumentos icônicos"
    },
    "image": {
      "tipo": "string (URL)",
      "requerido": true,
      "regra": "URL válida, preferencialmente w>=800px",
      "exemplo": "https://images.unsplash.com/..."
    },
    "price": {
      "tipo": "number",
      "requerido": true,
      "regra": "Inteiro positivo, será exibido como R$",
      "exemplo": 280, 450, 1500
    },
    "originalPrice": {
      "tipo": "number",
      "requerido": false,
      "regra": "Deve ser > price para mostrar desconto",
      "exemplo": 380, 580, 2000
    },
    "rating": {
      "tipo": "number",
      "requerido": true,
      "regra": "Entre 0 e 5, com 1 casa decimal",
      "exemplo": 4.8, 4.9, 4.7
    },
    "reviews": {
      "tipo": "number",
      "requerido": true,
      "regra": "Inteiro positivo realista",
      "exemplo": 100, 300, 500
    },
    "duration": {
      "tipo": "number",
      "requerido": true,
      "regra": "Número de dias (3-14 típico)",
      "exemplo": 3, 5, 7
    },
    "category": {
      "tipo": "string (enum)",
      "requerido": true,
      "regra": "Deve ser: beach, mountain, city, adventure",
      "exemplo": "beach"
    }
  },

  "dicas_de_preenchimento": [
    "Sempre traduza titles e descriptions para português",
    "Use imagens de qualidade de sites como Unsplash",
    "Preços devem ser realistas e competitivos",
    "A maioria dos pacotes deve ter originalPrice (desconto atrai clientes)",
    "Reviews > 200 parece mais legítimo",
    "Rating 4.7+ é mais credível",
    "Duração típica entre 4-7 dias",
    "Escolha categoria que melhor descreve o pacote"
  ],

  "script_para_adicionar_rapido": {
    "como": "Copie o exemplo abaixo e preencha com seus dados",
    "exemplo": `
